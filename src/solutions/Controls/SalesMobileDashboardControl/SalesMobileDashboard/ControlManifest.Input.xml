<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="kls.SalesMobileDashboard" constructor="SalesMobileDashboard" version="6.0.0" display-name-key="Sales Mobile Dashboard" description-key="Home dashboard for Dynamics 365 Sales mobile users" control-type="standard" >
    <external-service-usage enabled="true">
      <domain>app.powerbi.com</domain>
    </external-service-usage>

    <property
      name="recordLimit"
      display-name-key="Record Limit"
      description-key="Maximum records rendered per section"
      of-type="Whole.None"
      usage="input"
      required="false"
    />

    <property
      name="lookAheadDays"
      display-name-key="Appointment Look Ahead Days"
      description-key="Number of days to query upcoming appointments"
      of-type="Whole.None"
      usage="input"
      required="false"
    />

    <property
      name="powerBiEmbedUrl"
      display-name-key="Power BI Embed Url"
      description-key="Embed URL for the Power BI report"
      of-type="SingleLine.Text"
      usage="input"
      required="false"
    />

    <property
      name="powerBiReportId"
      display-name-key="Power BI Report Id"
      description-key="Report ID for the Power BI report"
      of-type="SingleLine.Text"
      usage="input"
      required="false"
    />

    <property
      name="powerBiAccessToken"
      display-name-key="Power BI Access Token"
      description-key="Access token used to embed the Power BI report"
      of-type="Multiple"
      usage="input"
      required="false"
    />

    <property
      name="powerBiTokenType"
      display-name-key="Power BI Token Type"
      description-key="Token type: 0 for AAD, 1 for Embed"
      of-type="SingleLine.Text"
      usage="input"
      required="false"
    />

    <data-set
      name="dashboardDataSet"
      display-name-key="Dashboard Data Set"
      description-key="Dataset required for table view hosting"
      cds-data-set-options="displayCommandBar:false;displayViewSelector:false;displayQuickFind:false;displayGroupBy:false"
    />

    <resources>
      <code path="index.ts" order="1" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="PowerAppsComponentFramework" required="false" />
    </feature-usage>
  </control>
</manifest>
